NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" do Supabase (Project Settings > API) — NUNCA a chave
# anon aqui. Só o servidor usa; nunca prefixar com NEXT_PUBLIC_ (isso a
# colocaria no navegador). Mantém acesso mesmo com o banco fechado (RLS).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Senha única para abrir o sistema (tela /entrar).
APP_SENHA=escolha-uma-senha
